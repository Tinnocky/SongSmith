/* ── form labels ── */
AuthWindow QLabel {
    color: #565f89;
    font-size: 14px;
    font-weight: 500;
}

/* ── error label ── */
AuthWindow QLabel#error_label {
    color: #f7768e;
    font-size: 13px;
    font-weight: 500;
}

/* ── submit button — sizing only, colors from base ── */
AuthWindow QPushButton#submit_btn {
    border-radius: 8px;
    padding: 12px 20px;
    font-size: 16px;
    min-height: 24px;
}

/* ── switch mode — link style ── */
AuthWindow QPushButton#switch_mode_btn {
    background-color: transparent;
    border: none;
    color: #7aa2f7;
    font-size: 15px;
    font-weight: 600;
    padding: 8px 4px;
}

AuthWindow QPushButton#switch_mode_btn:hover {
    color: #89b4fa;
    background-color: transparent;
    border: none;
}

/* ── reveal password button ── */
AuthWindow QPushButton#reveal_password_btn {
    background-color: transparent;
    border: 1px solid #414868;
    border-radius: 8px;
    color: #565f89;
    padding: 6px 12px;
    font-size: 13px;
    min-width: 54px;
    max-width: 54px;
    font-weight: 500;
}

AuthWindow QPushButton#reveal_password_btn:hover {
    color: #c0caf5;
    border-color: #565f89;
    background-color: transparent;
}

AuthWindow QPushButton#reveal_password_btn:checked {
    color: #7aa2f7;
    border-color: #7aa2f7;
}
