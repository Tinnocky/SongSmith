/* form labels */
ComposeWindow QLabel {
    color: #565f89;
    font-size: 14px;
    font-weight: 500;
}

/* compose button (sizing only, colors from base) */
ComposeWindow QPushButton#compose_btn {
    border-radius: 8px;
    padding: 13px 32px;
    font-size: 16px;
    min-height: 26px;
}

/* shared playback button base */
ComposeWindow QPushButton#pause_btn,
ComposeWindow QPushButton#save_btn,
ComposeWindow QPushButton#discard_btn {
    background-color: transparent;
    border-radius: 8px;
    padding: 9px 20px;
    font-weight: 600;
}

/* pause/play */
ComposeWindow QPushButton#pause_btn {
    border: 1px solid #7aa2f7;
    color: #7aa2f7;
}

ComposeWindow QPushButton#pause_btn:hover {
    background-color: #7aa2f7;
    color: #1a1b26;
}

/* save */
ComposeWindow QPushButton#save_btn {
    border: 1px solid #9ece6a;
    color: #9ece6a;
}

ComposeWindow QPushButton#save_btn:hover {
    background-color: #9ece6a;
    color: #1a1b26;
}

/* discard (sizing only, colors from base) */
ComposeWindow QPushButton#discard_btn {
    border-radius: 8px;
    padding: 9px 20px;
}

/* playback container */
ComposeWindow QWidget#playback_widget {
    background-color: #24283b;
    border: 1px solid #414868;
    border-radius: 10px;
}
