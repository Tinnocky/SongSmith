/* shared action button base */
StorageWindow QPushButton#rename_btn,
StorageWindow QPushButton#extract_btn {
    background-color: transparent;
    border: 1px solid #414868;
    color: #c0caf5;
    border-radius: 8px;
    padding: 9px 20px;
    font-weight: 500;
}

/* rename */
StorageWindow QPushButton#rename_btn:hover {
    border-color: #bb9af7;
    color: #bb9af7;
}

/* extract */
StorageWindow QPushButton#extract_btn:hover {
    border-color: #e0af68;
    color: #e0af68;
}

/* refresh */
StorageWindow QPushButton#refresh_btn {
    background-color: transparent;
    border: 1px solid #414868;
    color: #565f89;
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 500;
}

StorageWindow QPushButton#refresh_btn:hover {
    border-color: #7aa2f7;
    color: #7aa2f7;
}

/* play (sizing only, colors from base) */
StorageWindow QPushButton#play_btn {
    border-radius: 8px;
    padding: 9px 20px;
    font-size: 14px;
}

/* delete (sizing only, colors from base) */
StorageWindow QPushButton#delete_btn {
    border-radius: 8px;
    padding: 9px 20px;
    font-weight: 600;
}

/* song row labels */
QLabel#song_name_label {
    font-size: 16px;
    font-weight: 600;
    color: #c0caf5;
}

QLabel#song_info_label {
    font-size: 12px;
    color: #565f89;
}
