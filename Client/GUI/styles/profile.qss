/* ── labels ── */
ProfileWindow QLabel {
    color: #565f89;
    font-size: 14px;
    font-weight: 500;
}

ProfileWindow QLabel#username_label {
    color: #c0caf5;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -1px;
}

ProfileWindow QLabel#songs_saved_label {
    font-size: 15px;
}

ProfileWindow QLabel#section_title {
    color: #7aa2f7;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

ProfileWindow QLabel#danger_title {
    color: #f7768e;
    font-size: 18px;
    font-weight: 700;
}

ProfileWindow QLabel#danger_description {
    font-size: 15px;
}

/* ── shared button base ── */
ProfileWindow QPushButton#change_password_btn,
ProfileWindow QPushButton#delete_account_btn {
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 15px;
}

/* ── change password — accent fill ── */
ProfileWindow QPushButton#change_password_btn {
    background-color: #7aa2f7;
    color: #1a1b26;
    border: none;
    font-weight: 700;
}

ProfileWindow QPushButton#change_password_btn:hover {
    background-color: #89b4fa;
}

ProfileWindow QPushButton#change_password_btn:pressed {
    background-color: #5f8fd6;
}

/* ── delete account — red outline ── */
ProfileWindow QPushButton#delete_account_btn {
    background-color: transparent;
    border: 1px solid #f7768e;
    color: #f7768e;
    font-weight: 600;
}

ProfileWindow QPushButton#delete_account_btn:hover {
    background-color: #f7768e;
    color: #1a1b26;
}

/* ── error / success label ── */
QLabel#error_label[state="error"] {
    color: #f7768e;
}

QLabel#error_label[state="success"] {
    color: #9ece6a;
}

/* ── message boxes ── */
QMessageBox {
    background-color: #1a1b26;
    color: #c0caf5;
}

QMessageBox QLabel {
    color: #c0caf5;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 16px;
}
