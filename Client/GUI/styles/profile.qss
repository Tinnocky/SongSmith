/* labels */
ProfileWindow QLabel {
    color: #565f89;
    font-size: 14px;
    font-weight: 500;
}

ProfileWindow QLabel#username_label {
    color: #c0caf5;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -1px;
}

ProfileWindow QLabel#songs_saved_label {
    font-size: 15px;
}

ProfileWindow QLabel#section_title {
    color: #7aa2f7;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

ProfileWindow QLabel#danger_title {
    color: #f7768e;
    font-size: 18px;
    font-weight: 700;
}

ProfileWindow QLabel#danger_description {
    font-size: 15px;
}

/* shared button sizing */
ProfileWindow QPushButton#change_password_btn,
ProfileWindow QPushButton#delete_account_btn {
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 15px;
}

/* change password (sizing only, colors from base) */
ProfileWindow QPushButton#change_password_btn {
    font-weight: 700;
}

/* delete account (sizing only, colors from base) */
ProfileWindow QPushButton#delete_account_btn {
    font-weight: 600;
}

/* reveal password button */
ProfileWindow QPushButton#reveal_password_btn {
    background-color: transparent;
    border: 1px solid #414868;
    border-radius: 8px;
    color: #565f89;
    padding: 6px 12px;
    font-size: 13px;
    min-width: 54px;
    max-width: 54px;
    font-weight: 500;
}

ProfileWindow QPushButton#reveal_password_btn:hover {
    color: #c0caf5;
    border-color: #565f89;
    background-color: transparent;
}

ProfileWindow QPushButton#reveal_password_btn:checked {
    color: #7aa2f7;
    border-color: #7aa2f7;
}

/* error/success label */
QLabel#error_label[state="error"] {
    color: #f7768e;
}

QLabel#error_label[state="success"] {
    color: #9ece6a;
}
